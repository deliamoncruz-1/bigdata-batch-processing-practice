  create  table "airflow"."drive_trusted"."pii_data__dbt_tmp"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        dp.person_name,
        dp.user_name,
        dp.email,
        dp.personal_number,
        dp.birth_date,
        da.address,
        dp.phone_number,
        da.mac_address,
        da.ip_address,
        df.clabe,
        dd.accessed_at,
        fnu.session_duration,
        fnu.download_speed,
        fnu.upload_speed,
        fnu.consumed_traffic,
        fnu.unique_id

    FROM "airflow"."drive_staging"."fact_network_usage" fnu

    INNER JOIN "airflow"."drive_staging"."dim_address" da
        ON fnu.unique_id = da.unique_id

    INNER JOIN "airflow"."drive_staging"."dim_date" dd
        ON da.unique_id = dd.unique_id

    INNER JOIN "airflow"."drive_staging"."dim_finance" df
        ON dd.unique_id = df.unique_id

    INNER JOIN "airflow"."drive_staging"."dim_person" dp
        ON df.unique_id = dp.unique_id
)

SELECT *
FROM source_data
  );
  
